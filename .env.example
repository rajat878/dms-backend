# Copy this file to .env and fill in your local Postgres connection string.
# Render provides this automatically as an environment variable once you
# attach a Postgres database — you don't need to set it manually there.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dms_test

# Required in production: shared secret the admin dashboard sends as
# `Authorization: Bearer <token>` on every /api call. Without this set,
# the entire fleet-control API (reboot, lock, install, push content...) is
# open to anyone with the URL. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# Optional: Slack-compatible incoming webhook URL. If set, the backend
# posts a message whenever a device goes offline / battery-low / storage-low,
# and again when it recovers. If unset, alerts are still computed and
# available at GET /api/alerts, just not pushed anywhere.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Optional: tune alert thresholds (defaults shown)
# OFFLINE_THRESHOLD_MINUTES=20
# LOW_BATTERY_PCT=20
# LOW_STORAGE_BYTES=1073741824
# ALERT_CHECK_INTERVAL_MS=300000

# Optional: force the base URL used for uploaded-APK download links
# (e.g. https://dms-backend-1d7a.onrender.com). Only needed if req.protocol
# detection behind your proxy ever reports "http" for an https request —
# Android refuses to download over cleartext http by default.
# Also REQUIRED for Calendar schedules of type "Install app" / "Push ad" —
# those fire from a background timer (scheduler.js) with no incoming
# request to read a host from, so PUBLIC_BASE_URL is the only way it can
# build the apk/ad URL the device downloads.
# PUBLIC_BASE_URL=https://your-backend.example.com

# Optional: how often (ms) the calendar's background scheduler checks for
# due device-action schedules (reboot, lock, install app...). Default 1
# minute — a schedule fires within one tick of its set time.
# SCHEDULE_CHECK_INTERVAL_MS=60000

# IMPORTANT for Calendar schedules: the timezone schedule times ("start
# time 15:00" etc, entered in the dashboard) are evaluated in. Without
# this set, the DB session defaults to UTC (Render's default), so a
# schedule an admin in India enters as "15:00" will actually fire at
# 15:00 UTC = 20:30 IST — it looks like schedules "don't fire on time"
# even though the dashboard shows the correct time you typed.
# Set this to your admin's real IANA timezone.
# SCHEDULE_TZ=Asia/Kolkata
