# Copy this file to .env and fill in your local Postgres connection string.
# Render provides this automatically as an environment variable once you
# attach a Postgres database — you don't need to set it manually there.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dms_test

# Optional: Slack-compatible incoming webhook URL. If set, the backend
# posts a message whenever a device goes offline / battery-low / storage-low,
# and again when it recovers. If unset, alerts are still computed and
# available at GET /api/alerts, just not pushed anywhere.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Optional: tune alert thresholds (defaults shown)
# OFFLINE_THRESHOLD_MINUTES=20
# LOW_BATTERY_PCT=20
# LOW_STORAGE_BYTES=1073741824
# ALERT_CHECK_INTERVAL_MS=300000

# Optional: force the base URL used for uploaded-APK download links
# (e.g. https://dms-backend-1d7a.onrender.com). Only needed if req.protocol
# detection behind your proxy ever reports "http" for an https request —
# Android refuses to download over cleartext http by default.
# PUBLIC_BASE_URL=https://your-backend.example.com
